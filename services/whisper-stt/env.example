# Copy to ~/.config/whisper-stt/env, replace the key, and chmod 0600.
API_KEY=replace-with-a-random-secret
PRELOAD_MODELS=["deepdml/faster-whisper-large-v3-turbo-ct2"]
WHISPER__INFERENCE_DEVICE=cuda
WHISPER__COMPUTE_TYPE=float16
# This pinned Speaches version uses nested Pydantic names. -1 keeps the model
# resident indefinitely; STT_MODEL_TTL is ignored and defaults to 300 seconds.
WHISPER__TTL=-1
ENABLE_UI=false
LOG_LEVEL=info
DO_NOT_TRACK=true
HF_HUB_DISABLE_TELEMETRY=1
# Consumed by whisper-stt-warmup rather than Speaches itself.
WHISPER_MODEL=deepdml/faster-whisper-large-v3-turbo-ct2
