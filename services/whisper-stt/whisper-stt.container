[Unit]
Description=Private GPU Whisper transcription API
Wants=network-online.target
After=network-online.target

[Container]
Image=ghcr.io/speaches-ai/speaches@sha256:6ec12ebf890a17e0d4b242a8ba9e0eb1fb836e60e8a3c857aea9838d541579ac
ContainerName=whisper-stt
Pull=never
AddDevice=nvidia.com/gpu=all
SecurityLabelDisable=true
EnvironmentFile=%h/.config/whisper-stt/env
PublishPort=127.0.0.1:8001:8000
Volume=whisper-stt-models.volume:/home/ubuntu/.cache/huggingface/hub

[Service]
Restart=always
RestartSec=5
TimeoutStartSec=900
TimeoutStopSec=45
ExecStartPost=%h/.local/bin/whisper-stt-warmup

[Install]
WantedBy=default.target
