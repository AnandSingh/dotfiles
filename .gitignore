.DS_Store
*.old
*.backup
*.swp
*.swo
*~
# Ignore Claude's local state, but track repo-provided skills so they sync.
.claude/*
!.claude/skills/
!.claude/skills/**
*.bak.*

# Per-machine Sway overrides (monitors, inputs, machine-only apps).
# Seeded from sway/.config/sway/examples/ by bootstrap.sh on each host.
sway/.config/sway/config.d/local.conf

# Per-machine xprofile override. Lives at $HOME/.xprofile.local (sourced by the
# common ~/.xprofile), seeded per-OS from xprofile/examples/ by bootstrap.sh.
.xprofile.local

# Per-machine kitty override. Lives at $HOME/.config/kitty/local.conf (included
# by kitty.conf), seeded per-OS from kitty/examples/ by bootstrap.sh.
.config/kitty/local.conf
