# Per-machine Sway overrides — generic template.
# Copy to ../config.d/local.conf and edit for this host.
#
#   cp ~/.config/sway/examples/local.conf.example \
#      ~/.config/sway/config.d/local.conf
#
# This file is sourced by the base config via:
#   include ~/.config/sway/config.d/*.conf

# ==================== Monitors ====================
# List `swaymsg -t get_outputs` to find names, then place them:
# output eDP-1 resolution 1920x1080 position 0,0 scale 1
# output HDMI-A-1 resolution 3840x2160 position 1920,0
# output * bg #1e1e2e solid_color

# ==================== Input ====================
# input "type:keyboard" {
#     xkb_layout us
#     xkb_options ctrl:nocaps
#     repeat_delay 300
#     repeat_rate 50
# }
# input "type:touchpad" {
#     tap enabled
#     natural_scroll enabled
#     dwt enabled
#     middle_emulation enabled
# }

# ==================== Machine-only autostart ====================
# exec some-app-only-on-this-host
