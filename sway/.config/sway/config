# Sway config — clean modern, AMD RX 6800 XT, 3840x2400

# ==================== Output / Monitors ====================

output eDP-1 resolution 3840x2400 position 0,0 scale 1
output DP-1 resolution 3840x2160 position 3840,0
output DP-2 resolution 3840x2160 position 0,0
output HDMI-A-1 resolution 1920x1080 position 0,0 transform 90
output * bg #1e1e2e solid_color

# ==================== Input ====================

input type:keyboard {
    xkb_layout us
    repeat_delay 300
    repeat_rate 50
}

input type:touchpad {
    tap enabled
    natural_scroll disabled
    dwt enabled
    middle_emulation enabled
}

# ==================== Variables ====================

set $mod Mod4
set $term kitty
set $browser google-chrome
set $filemanager thunar
set $menu rofi -show drun -modi drun,run,window
set $lock swaylock -f

# ==================== Appearance ====================

default_border pixel 2
default_floating_border pixel 2
gaps inner 4
gaps outer 2
smart_gaps on
smart_borders on

# class                 border  bg      text    indicator child_border
client.focused          #89b4fa #1e1e2e #cdd6f4 #89b4fa   #89b4fa
client.focused_inactive #45475a #1e1e2e #cdd6f4 #45475a   #45475a
client.unfocused        #313244 #1e1e2e #a6adc8 #313244   #313244
client.urgent           #f38ba8 #1e1e2e #cdd6f4 #f38ba8   #f38ba8

font pango:JetBrainsMono Nerd Font 10

# ==================== Autostart ====================

exec_always --no-startup-id {
    gsettings set org.gnome.desktop.interface gtk-theme 'Adwaita-dark'
    gsettings set org.gnome.desktop.interface icon-theme 'Adwaita'
    gsettings set org.gnome.desktop.interface color-scheme 'prefer-dark'
}

exec {
    waybar
    # swaync (install SwayNotificationCenter if desired)
    nm-applet --indicator
    wl-paste --type text --watch cliphist store
    wl-paste --type image --watch cliphist store
    swww-daemon --format xrgb
    sleep 1 && swww img ~/Pictures/wallpapers/catppuccin-geometric.png --transition-type fade --transition-duration 1
    swayidle -w \
        timeout 300 '$lock' \
        timeout 600 'swaymsg "output * power off"' \
        resume 'swaymsg "output * power on"' \
        before-sleep '$lock'
}

# Autostart apps on login
exec swaymsg "workspace 1; exec $term -e tmux new-session -A -s main"
exec swaymsg "workspace 2; exec $browser"
exec swaymsg "workspace 7; exec $browser --new-window --app=https://chat.google.com"

# ==================== Key Bindings — Apps ====================

bindsym $mod+Return exec swaymsg '[app_id="kitty"]' focus || exec $term
bindsym $mod+t exec swaymsg '[app_id="kitty"]' focus || exec $term
bindsym $mod+space exec $menu
bindsym $mod+b exec $browser --new-window
bindsym $mod+e exec $filemanager
bindsym $mod+c exec code-fb

# Dropdown terminal — rolls down from top, toggle with $mod+grave
bindsym $mod+grave exec swaymsg '[app_id="dropdown"]' scratchpad show || exec $term --class dropdown -o shell=zsh

# ==================== Key Bindings — Window ====================

# Alt+Tab to cycle windows (familiar from GNOME/Windows)
bindsym Alt+Tab focus next
bindsym Alt+Shift+Tab focus prev

bindsym $mod+q kill
bindsym $mod+Shift+q exec swaymsg [con_id=$(swaymsg -t get_tree | jq '.. | select(.focused?) | .id')] kill

bindsym $mod+f fullscreen toggle
bindsym $mod+Shift+f floating toggle
bindsym $mod+Shift+s sticky toggle

# Focus (vim keys)
bindsym $mod+h focus left
bindsym $mod+j focus down
bindsym $mod+k focus up
bindsym $mod+l focus right

# Move windows (vim keys)
bindsym $mod+Shift+h move left
bindsym $mod+Shift+j move down
bindsym $mod+Shift+k move up
bindsym $mod+Shift+l move right

# Resize
bindsym $mod+Control+h resize shrink width 20px
bindsym $mod+Control+j resize grow height 20px
bindsym $mod+Control+k resize shrink height 20px
bindsym $mod+Control+l resize grow width 20px

# Layout
bindsym $mod+v splith
bindsym $mod+s splitv
bindsym $mod+w layout tabbed
bindsym $mod+Shift+w layout toggle split

# Scratchpad
bindsym $mod+minus move scratchpad
bindsym $mod+equal scratchpad show

# Float drag/resize
floating_modifier $mod normal

# ==================== Workspaces ====================

bindsym $mod+1 workspace number 1
bindsym $mod+2 workspace number 2
bindsym $mod+3 workspace number 3
bindsym $mod+4 workspace number 4
bindsym $mod+5 workspace number 5
bindsym $mod+6 workspace number 6
bindsym $mod+7 workspace number 7
bindsym $mod+8 workspace number 8
bindsym $mod+9 workspace number 9
bindsym $mod+0 workspace number 10

bindsym $mod+Shift+1 move container to workspace number 1
bindsym $mod+Shift+2 move container to workspace number 2
bindsym $mod+Shift+3 move container to workspace number 3
bindsym $mod+Shift+4 move container to workspace number 4
bindsym $mod+Shift+5 move container to workspace number 5
bindsym $mod+Shift+6 move container to workspace number 6
bindsym $mod+Shift+7 move container to workspace number 7
bindsym $mod+Shift+8 move container to workspace number 8
bindsym $mod+Shift+9 move container to workspace number 9
bindsym $mod+Shift+0 move container to workspace number 10

bindsym $mod+Tab workspace next_on_output
bindsym $mod+Shift+Tab workspace prev_on_output

bindsym --whole-window $mod+button4 workspace prev_on_output
bindsym --whole-window $mod+button5 workspace next_on_output

# ==================== System ====================

bindsym $mod+Shift+r reload
bindsym $mod+Shift+e exec swaynag -t warning -m 'Exit Sway?' -B 'Yes' 'swaymsg exit'
bindsym Control+Alt+l exec $lock
bindsym Control+Alt+Delete exec wlogout

# Screenshots
bindsym Print exec grim - | wl-copy && notify-send "Screenshot copied"
bindsym $mod+Print exec grim ~/Pictures/screenshot-$(date +%Y%m%d-%H%M%S).png && notify-send "Screenshot saved"
bindsym $mod+Shift+Print exec grim -g "$(slurp)" - | wl-copy && notify-send "Area copied"
bindsym Alt+Print exec swaymsg -t get_tree | jq -r '.. | select(.focused?) | .rect | "\(.x),\(.y) \(.width)x\(.height)"' | grim -g - - | wl-copy && notify-send "Window copied"

# Clipboard manager
bindsym $mod+Alt+v exec cliphist list | rofi -dmenu -p "Clipboard" | cliphist decode | wl-copy

# Media keys
bindsym XF86AudioRaiseVolume exec wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%+
bindsym XF86AudioLowerVolume exec wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-
bindsym XF86AudioMute exec wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle
bindsym XF86AudioMicMute exec wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle

bindsym XF86MonBrightnessUp exec brightnessctl set +5%
bindsym XF86MonBrightnessDown exec brightnessctl set 5%-

bindsym XF86AudioPlay exec playerctl play-pause
bindsym XF86AudioNext exec playerctl next
bindsym XF86AudioPrev exec playerctl previous

# Notification center
bindsym $mod+n exec swaync-client -t -sw

# ==================== Window Rules ====================

# Auto-assign apps to workspaces and focus on open
assign [app_id="google-chrome"] workspace number 2
assign [class="Google-chrome"] workspace number 2
assign [class="Code"] workspace number 3
assign [class="code-fb"] workspace number 3
assign [app_id="thunar"] workspace number 4
assign [class="Google Chat"] workspace number 7
assign [title="Google Chat"] workspace number 7

# Chrome profiles open tabbed instead of side-by-side
for_window [app_id="google-chrome"] layout tabbed
for_window [class="Google-chrome"] layout tabbed

# Auto-focus workspace when assigned app opens
for_window [app_id="google-chrome"] focus
for_window [class="Google-chrome"] focus
for_window [class="Code"] focus
for_window [class="code-fb"] focus
for_window [app_id="thunar"] focus
for_window [class="Google Chat"] focus

# Dropdown terminal — centered, quake-style
for_window [app_id="dropdown"] {
    floating enable
    resize set 50 ppt 40 ppt
    move position center
    border pixel 2
    move to scratchpad
    scratchpad show
}

for_window [app_id="pavucontrol"] floating enable, resize set 800 600
for_window [app_id="nm-connection-editor"] floating enable
for_window [app_id="blueman-manager"] floating enable
for_window [app_id="thunar" title="File Operation Progress"] floating enable
for_window [app_id="org.gnome.Calculator"] floating enable
for_window [app_id="xdg-desktop-portal-gtk"] floating enable
for_window [title="Picture-in-Picture"] floating enable, sticky enable, resize set 480 270, move position 80 ppt 5 ppt
for_window [window_role="pop-up"] floating enable
for_window [window_role="dialog"] floating enable

# ==================== XWayland ====================

xwayland enable

# ==================== Include ====================

include /etc/sway/config.d/*
