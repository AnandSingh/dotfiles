# Sway config — clean modern, portable base. Per-host monitors, inputs, and
# apps live in config.d/local.conf (seeded per-OS by bootstrap.sh, last include wins).

# ==================== Output / Monitors ====================

# Monitor resolutions/positions are host-specific — see config.d/local.conf.
output * bg #1e1e2e solid_color

# ==================== Input ====================

input type:keyboard {
    xkb_layout us
    repeat_delay 300
    repeat_rate 50
}

input type:touchpad {
    tap enabled
    natural_scroll disabled
    dwt enabled
    middle_emulation enabled
}

# ==================== Variables ====================

set $mod Mod4
set $term kitty
set $browser google-chrome
set $filemanager thunar
set $menu rofi -show drun -modi drun,run,window
set $lock swaylock -f

# Workspace labels kept as documentation. Commands below use numeric workspaces
# for maximum compatibility with helper scripts and existing sessions.
set $ws1 "1:term"
set $ws2 "2:remote"
set $ws3 "3:ai"
set $ws4 "4:files"
set $ws5 "5:code"
set $ws6 "6:ops"
set $ws7 "7:web"
set $ws8 "8:notes"
set $ws9 "9:flex"
set $ws10 "10:flex"

# ==================== Appearance ====================

default_border pixel 2
default_floating_border pixel 2
gaps inner 4
gaps outer 2
smart_gaps on
smart_borders on

# Keep keyboard focus stable on large displays; focus changes only by click or key.
focus_follows_mouse no

# class                 border  bg      text    indicator child_border
client.focused          #89b4fa #1e1e2e #cdd6f4 #89b4fa   #89b4fa
client.focused_inactive #45475a #1e1e2e #cdd6f4 #45475a   #45475a
client.unfocused        #313244 #1e1e2e #a6adc8 #313244   #313244
client.urgent           #f38ba8 #1e1e2e #cdd6f4 #f38ba8   #f38ba8

font pango:JetBrainsMono Nerd Font 10

# ==================== Autostart ====================

exec --no-startup-id {
    gsettings set org.gnome.desktop.interface gtk-theme 'Adwaita-dark'
    gsettings set org.gnome.desktop.interface icon-theme 'Adwaita'
    gsettings set org.gnome.desktop.interface color-scheme 'prefer-dark'
}

# Portals are D-Bus/systemd activated. Starting them manually races their service
# lifecycle and can leave stale instances after a compositor restart.
exec {
    waybar
    nm-applet --indicator
    wl-paste --type text --watch cliphist store
    wl-paste --type image --watch cliphist store
    # No inactivity timeout: keep manual locking and lock before real sleep.
    swayidle -w \
        before-sleep '$lock' \
        after-resume '~/.config/sway/scripts/lid-sync.sh'
}

# Autostart apps on login
# Workspace 1: Telisky task-worktree tmux session on every Linux workstation.
exec swaymsg "workspace 1; exec $term -e sh -c 'if [ -x \"$HOME/.local/bin/telisky-tmux\" ]; then exec \"$HOME/.local/bin/telisky-tmux\"; else exec tmux new-session -A -s main; fi'"
# Remote workspaces 2 and 3 launch on first visit through ws-launch instead of
# creating network sessions at every login.
# exec swaymsg "workspace 7; exec $browser --new-window --app=https://chat.google.com"  # disabled: Google Chat autostart removed
exec ~/.config/sway/scripts/dropdown-autohide.sh

# ==================== Key Bindings — Apps ====================

bindsym $mod+Return exec swaymsg '[app_id="kitty"]' focus || exec $term
# Dedicated remote development terminal (Ghostty, with Kitty fallback).
bindsym $mod+Shift+Return exec ~/.local/bin/workspace open remote
bindsym $mod+t exec swaymsg '[app_id="kitty"]' focus || exec $term
bindsym $mod+space exec $menu
bindsym $mod+b exec $browser --new-window
bindsym $mod+e exec $filemanager

# Wispr Flow-style dictation: hold either one-key mic control or F10 to record;
# release to transcribe and paste. Fn itself is handled by keyboard firmware and
# emits no bindable Linux key event.
bindsym --no-warn --locked XF86AudioMicMute exec ~/.local/bin/vocalinux-ptt start
bindsym --no-warn --locked --release XF86AudioMicMute exec ~/.local/bin/vocalinux-ptt stop
bindsym --no-warn --locked F10 exec ~/.local/bin/vocalinux-ptt start
bindsym --no-warn --locked --release F10 exec ~/.local/bin/vocalinux-ptt stop

# Nexus Deck — dedicated terminal; opens or focuses without disturbing current tmux
bindsym $mod+d exec ~/.local/bin/nexusctl dashboard --new-terminal

# Dropdown terminal — rolls down from top, toggle with $mod+grave
bindsym $mod+grave exec swaymsg '[app_id="dropdown"]' scratchpad show || exec $term --class dropdown -o shell=zsh

# Developer notes — jump to Zettlr; press again to return to the prior workspace
bindsym $mod+n exec ~/.config/sway/scripts/notes-workspace.sh

# ==================== Key Bindings — Window ====================

# Alt+Tab to cycle windows (familiar from GNOME/Windows)
bindsym Alt+Tab focus next
bindsym Alt+Shift+Tab focus prev

bindsym $mod+q kill
bindsym $mod+Shift+q exec swaymsg [con_id=$(swaymsg -t get_tree | jq '.. | select(.focused?) | .id')] kill

bindsym $mod+f fullscreen toggle
bindsym $mod+Shift+f floating toggle
bindsym $mod+Shift+s sticky toggle

# Focus (vim keys)
bindsym $mod+h focus left
bindsym $mod+j focus down
bindsym $mod+k focus up
bindsym $mod+l focus right

# Move windows (vim keys)
bindsym $mod+Shift+h move left
bindsym $mod+Shift+j move down
bindsym $mod+Shift+k move up
bindsym $mod+Shift+l move right

# Resize
bindsym $mod+Control+h resize shrink width 20px
bindsym $mod+Control+j resize grow height 20px
bindsym $mod+Control+k resize shrink height 20px
bindsym $mod+Control+l resize grow width 20px

# Layout
bindsym $mod+v splith
bindsym $mod+s splitv
bindsym $mod+w layout tabbed
bindsym $mod+z layout stacking
bindsym $mod+x layout toggle split
bindsym $mod+c focus parent
bindsym $mod+Shift+w layout toggle split

# Scratchpad
bindsym $mod+minus move scratchpad
bindsym $mod+equal scratchpad show

# Float drag/resize
floating_modifier $mod normal

# ==================== Workspaces ====================

bindsym $mod+1 exec ~/.local/bin/workspace open terminal
bindsym $mod+2 exec ~/.local/bin/workspace open remote
bindsym $mod+3 exec ~/.local/bin/workspace open ai
bindsym $mod+4 exec ~/.local/bin/workspace open files
bindsym $mod+5 exec ~/.local/bin/workspace open code
bindsym $mod+6 exec ~/.local/bin/workspace open ops
bindsym $mod+7 exec ~/.local/bin/workspace open web
bindsym $mod+8 exec ~/.local/bin/workspace open notes
bindsym $mod+9 exec ~/.local/bin/workspace open flex
bindsym $mod+0 workspace number 10

bindsym $mod+Shift+1 move container to workspace number 1
bindsym $mod+Shift+2 move container to workspace number 2
bindsym $mod+Shift+3 move container to workspace number 3
bindsym $mod+Shift+4 move container to workspace number 4
bindsym $mod+Shift+5 move container to workspace number 5
bindsym $mod+Shift+6 move container to workspace number 6
bindsym $mod+Shift+7 move container to workspace number 7
bindsym $mod+Shift+8 move container to workspace number 8
bindsym $mod+Shift+9 move container to workspace number 9
bindsym $mod+Shift+0 move container to workspace number 10

bindsym $mod+bracketleft workspace prev_on_output
bindsym $mod+bracketright workspace next_on_output
bindsym $mod+Shift+less move workspace to output left
bindsym $mod+Shift+greater move workspace to output right

# $mod+Tab — window switcher (jump to any window by name, Alt-Tab style)
bindsym $mod+Tab exec ~/.config/sway/scripts/window-switcher.sh
# Workspace overview — choose a named workspace and see its window count.
bindsym $mod+Shift+space exec ~/.local/bin/workspace overview
bindsym $mod+Shift+Tab workspace prev_on_output

bindsym --whole-window $mod+button4 workspace prev_on_output
bindsym --whole-window $mod+button5 workspace next_on_output

# ==================== System ====================

bindsym $mod+Shift+r reload
bindsym $mod+F1 exec ~/.config/sway/scripts/keybinding-help.sh
bindsym $mod+Shift+e exec swaynag -t warning -m 'Exit Sway?' -B 'Yes' 'swaymsg exit'
bindsym Control+Alt+l exec $lock
bindsym $mod+Shift+x exec $lock
bindsym Control+Alt+Delete exec ~/.config/sway/scripts/power-menu.sh

# Screenshots
bindsym Print exec grim - | wl-copy && notify-send "Screenshot copied"
bindsym $mod+Print exec grim ~/Pictures/screenshot-$(date +%Y%m%d-%H%M%S).png && notify-send "Screenshot saved"
bindsym $mod+Shift+Print exec grim -g "$(slurp)" - | swappy -f -
bindsym Alt+Print exec swaymsg -t get_tree | jq -r '.. | select(.focused?) | .rect | "\(.x),\(.y) \(.width)x\(.height)"' | grim -g - - | wl-copy && notify-send "Window copied"
# Print-key-free aliases (Advantage360 has no PrtSc on the base layer)
# $mod+p opens the area capture in swappy for annotate/crop/blur before save/copy
bindsym $mod+p exec grim -g "$(slurp)" - | swappy -f -
bindsym $mod+Shift+p exec grim ~/Pictures/screenshot-$(date +%Y%m%d-%H%M%S).png && notify-send "Screenshot saved"
bindsym $mod+Ctrl+p exec swaymsg -t get_tree | jq -r '.. | select(.focused?) | .rect | "\(.x),\(.y) \(.width)x\(.height)"' | grim -g - - | wl-copy && notify-send "Window copied"

# Clipboard manager
bindsym $mod+Alt+v exec cliphist list | rofi -dmenu -p "Clipboard" | cliphist decode | wl-copy
# Upload a clipboard image to both personal servers and copy one shared @path.
bindsym $mod+Shift+v exec ~/.local/bin/remote-clipboard

# Emoji picker (copies selection to clipboard)
bindsym $mod+period exec ~/.config/sway/scripts/emoji-picker.sh

# Media keys
bindsym XF86AudioRaiseVolume exec wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%+
bindsym XF86AudioLowerVolume exec wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-
bindsym XF86AudioMute exec wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle
# Bare mic media key is push-to-talk; hold Super with it for the original mute action.
bindsym $mod+XF86AudioMicMute exec wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle

bindsym XF86MonBrightnessUp exec brightnessctl set +5%
bindsym XF86MonBrightnessDown exec brightnessctl set 5%-

bindsym XF86AudioPlay exec playerctl play-pause
bindsym XF86AudioNext exec playerctl next
bindsym XF86AudioPrev exec playerctl previous

# Notification center (Super+n is reserved for developer notes)
bindsym $mod+Shift+n exec swaync-client -t -sw

# ==================== Window Rules ====================

# Workspace keys always switch to the requested destination. A profile app
# launches if it is not already there; apps on other workspaces stay put.
# Super+Tab searches globally, and Super+Shift+number moves a window deliberately.

# Browser windows tile side-by-side when opened together.
for_window [app_id="google-chrome"] layout splith
for_window [class="Google-chrome"] layout splith

# Dropdown terminal — centered, quake-style
for_window [app_id="dropdown"] {
    floating enable
    resize set 50 ppt 40 ppt
    move position center
    border pixel 2
    move to scratchpad
    scratchpad show
}

for_window [app_id="pavucontrol"] floating enable, resize set 800 600
for_window [app_id="nm-connection-editor"] floating enable
for_window [app_id="blueman-manager"] floating enable
for_window [app_id="thunar" title="File Operation Progress"] floating enable
for_window [app_id="org.gnome.Calculator"] floating enable
for_window [app_id="xdg-desktop-portal-gtk"] floating enable
for_window [title="Picture-in-Picture"] floating enable, sticky enable, resize set 480 270, move position 80 ppt 5 ppt
for_window [window_role="pop-up"] floating enable
for_window [window_role="dialog"] floating enable

# ==================== XWayland ====================

xwayland enable

# ==================== Include ====================

include /etc/sway/config.d/*

# Per-machine overrides (monitors, inputs, machine-only apps). Git-ignored;
# seeded from examples/ by bootstrap.sh per OS. Last include wins, so these
# override the defaults above.
include ~/.config/sway/config.d/*.conf
