#!/bin/sh
# ~/.xprofile — read by the X session at login (X11 only; Wayland/Sway ignores it).
#
# This file is COMMON to every machine. Put only host-agnostic tweaks here.
# Machine-specific bits (monitor modes via xrandr, per-host inputs) go in
# ~/.xprofile.local, which is git-ignored and seeded per-OS by bootstrap.sh
# from xprofile/examples/.

# Remap Caps Lock to Ctrl (harmless everywhere; no-op under Wayland)
setxkbmap -option ctrl:nocaps

# Per-machine overrides (monitors, resolutions, host-only env). Optional.
[ -r "$HOME/.xprofile.local" ] && . "$HOME/.xprofile.local"
