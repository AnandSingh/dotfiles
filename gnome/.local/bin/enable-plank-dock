#!/usr/bin/env bash
# Switch GNOME from Ubuntu Dock to Plank.

set -euo pipefail

if ! command -v plank >/dev/null 2>&1; then
  echo "Plank is not installed. Install it first:" >&2
  echo "  sudo apt install plank" >&2
  exit 1
fi

mkdir -p "$HOME/.config/autostart"

if command -v gnome-extensions >/dev/null 2>&1; then
  gnome-extensions disable ubuntu-dock@ubuntu.com || true
fi

# Start/replace Plank for the current graphical session.
pkill -x plank >/dev/null 2>&1 || true
nohup plank >/dev/null 2>&1 &

echo "Plank enabled. Ubuntu Dock disabled. Autostart is managed by ~/.config/autostart/plank.desktop."
