# Ghostty — Catppuccin Mocha, remote-development focused

font-family = JetBrains Mono
# Powerline and Nerd Font glyph fallback used by the shared tmux lightline bar.
font-family = Symbols Nerd Font Mono
font-size = 14
theme = Catppuccin Mocha

# Match the clean Sway/Kitty desktop while keeping text comfortably inset.
background-opacity = 1
window-padding-x = 8
window-padding-y = 10
window-decoration = none
confirm-close-surface = false

# Terminal behavior
copy-on-select = clipboard
clipboard-read = allow
cursor-style = bar
cursor-style-blink = false
window-inherit-working-directory = true
window-inherit-font-size = true
app-notifications = no-clipboard-copy

# Preserve TERM/terminfo behavior across SSH and keep zsh integration enabled.
shell-integration = zsh
shell-integration-features = cursor,sudo,title,ssh-env,ssh-terminfo

# Recommended by Pi; do not map Shift+Enter to a raw newline because tmux and
# Pi need the real modified-key event.
keybind = alt+backspace=text:\x1b\x7f
