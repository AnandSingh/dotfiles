# swaylock — Catppuccin Mocha (matches sway borders / waybar)
# Loaded automatically by `swaylock` (sway config: set $lock swaylock -f).

ignore-empty-password

font=JetBrainsMono Nerd Font
indicator-radius=100
indicator-thickness=10

# Base background + ring
color=1e1e2e
ring-color=313244
inside-color=1e1e2e
line-color=00000000
separator-color=00000000
text-color=cdd6f4

# Typing
key-hl-color=a6e3a1
bs-hl-color=f5e0dc
ring-ver-color=89b4fa
inside-ver-color=1e1e2e
text-ver-color=1e1e2e
line-ver-color=00000000

# Cleared
ring-clear-color=f5e0dc
inside-clear-color=1e1e2e
text-clear-color=1e1e2e
line-clear-color=00000000

# Wrong password
ring-wrong-color=f38ba8
inside-wrong-color=1e1e2e
text-wrong-color=1e1e2e
line-wrong-color=00000000

# Caps lock
ring-caps-lock-color=fab387
inside-caps-lock-color=1e1e2e
text-caps-lock-color=cdd6f4
caps-lock-key-hl-color=a6e3a1
caps-lock-bs-hl-color=f5e0dc
line-caps-lock-color=00000000

# Keyboard layout box
layout-bg-color=1e1e2e
layout-border-color=00000000
layout-text-color=cdd6f4
